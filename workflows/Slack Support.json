        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a support classifier. Return ONLY valid JSON with keys: category (billing/bug/general), summary (one sentence), priority (high/medium/low). No markdown, no backticks, just raw JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.userMessage }}\"\n    }\n  ]\n}",
        "options": {}
      },
