        "jsCode": "const tickets = $input.all();\n\nconst total = tickets.length;\nconst billing = tickets.filter(t => t.json.fields.Category === 'billing').length;\nconst bug = tickets.filter(t => t.json.fields.Category === 'bug').length;\nconst general = tickets.filter(t => t.json.fields.Category === 'general').length;\nconst high = tickets.filter(t => t.json.fields.Priority === 'high').length;\nconst medium = tickets.filter(t => t.json.fields.Priority === 'medium').length;\nconst low = tickets.filter(t => t.json.fields.Priority === 'low').length;\nconst resolved = tickets.filter(t => t.json.fields.Status === 'Resolved').length;\nconst open = tickets.filter(t => t.json.fields.Status === 'Open').length;\n\nreturn [{ json: {\n  total, billing, bug, general,\n  high, medium, low,\n  resolved, open,\n  week: new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })\n}}];"
